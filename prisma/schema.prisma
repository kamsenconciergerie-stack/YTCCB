generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ChaussureCategorie {
  FEMME
  HOMME
  ENFANT
  SPORT
  SANDALES
  BOTTES
  ESCARPINS
  SNEAKERS
  ACCESSOIRES
}

enum SourceImport {
  MANUEL
  CSV
  API
}

enum OrderStatus {
  PRE_CONFIRMEE  // créée, en attente de paiement
  PAYE           // paiement reçu
  EN_PREPARATION // en cours de préparation
  EN_LIVRAISON   // confiée au livreur
  LIVREE         // livrée au client
  EXPIREE        // non payée après 30 min
  ANNULEE        // annulée manuellement
}

enum CanalFinalisation {
  WEB
  WHATSAPP
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  A_LA_LIVRAISON
}

enum UserRole {
  ADMIN
  COMMERCIAL
}

// ─── Paramètres boutique ─────────────────────────────────────────────────────

model ParametresBoutique {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parametres_boutique")
}

// ─── Utilisateurs admin ───────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(COMMERCIAL)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Zones de livraison ───────────────────────────────────────────────────────

model DeliveryZone {
  id          String   @id @default(uuid())
  name        String
  description String?
  baseFee     Decimal  @map("base_fee") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  livreurs Livreur[]
  orders   Order[]

  @@map("delivery_zones")
}

// ─── Livreurs ─────────────────────────────────────────────────────────────────

model Livreur {
  id             String   @id @default(uuid())
  nom            String
  telephone      String   @unique
  whatsappNumber String?  @unique @map("whatsapp_number")
  deliveryZoneId String?  @map("delivery_zone_id")
  actif          Boolean  @default(true)
  disponible     Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  orders       Order[]

  @@index([actif, disponible])
  @@map("livreurs")
}

// ─── Chaussures ───────────────────────────────────────────────────────────────

model Chaussure {
  id                   String             @id @default(uuid())
  // Référence unique : MTS-2026-001
  reference            String             @unique
  nom                  String
  marque               String?
  categorie            ChaussureCategorie
  couleur              String?
  // Tableau JSON des pointures disponibles : ["36","37","38","39","40"]
  pointuresDisponibles Json               @default("[]") @map("pointures_disponibles")
  prix                 Decimal            @db.Decimal(10, 2)
  prixPromo            Decimal?           @map("prix_promo") @db.Decimal(10, 2)
  stockTotal           Int                @default(0) @map("stock_total")
  // Stock par pointure : {"36": 5, "37": 3, "38": 0}
  stocksParPointure    Json               @default("{}") @map("stocks_par_pointure")
  description          String?
  // Tableau JSON d'URLs images
  images               Json               @default("[]")
  fournisseurRef       String?            @map("fournisseur_ref")
  actif                Boolean            @default(true)
  featured             Boolean            @default(false)
  dateImport           DateTime?          @map("date_import")
  sourceImport         SourceImport       @default(MANUEL) @map("source_import")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([categorie])
  @@index([actif])
  @@index([featured])
  @@index([actif, categorie])
  @@index([reference])
  @@index([actif, featured])
  @@map("chaussures")
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(uuid())
  // Identifiant principal — format normalisé : +221XXXXXXXXX
  whatsappNumber String   @unique @map("whatsapp_number")
  name           String?
  email          String?  @unique
  address        String?
  city           String?
  isBlocked      Boolean  @default(false) @map("is_blocked")
  // Dénormalisé pour perf dashboard
  totalOrders    Int      @default(0) @map("total_orders")
  totalSpent     Decimal  @default(0) @map("total_spent") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders        Order[]
  loyaltyPoints LoyaltyPoint[]

  @@index([whatsappNumber])
  @@map("customers")
}

// ─── Commandes ────────────────────────────────────────────────────────────────

model Order {
  id                String            @id @default(uuid())
  // Format : MTS-YYYYMMDD-XXXX (généré côté app avant INSERT)
  numeroCommande    String            @unique @map("numero_commande")
  customerId        String            @map("customer_id")
  deliveryZoneId    String?           @map("delivery_zone_id")
  livreurId         String?           @map("livreur_id")
  status            OrderStatus       @default(PRE_CONFIRMEE)
  canalFinalisation CanalFinalisation @map("canal_finalisation")
  statutPaiement    StatutPaiement    @default(EN_ATTENTE) @map("statut_paiement")
  subtotal          Decimal           @db.Decimal(10, 2)
  deliveryFee       Decimal           @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  deliveryAddress   String?           @map("delivery_address")
  deliveryCity      String?           @map("delivery_city")
  // Lien Wave pour paiement (valable 30 min)
  lienPaiementWave  String?           @map("lien_paiement_wave")
  notes             String?
  cancelReason      String?           @map("cancel_reason")
  // Expiration automatique si non payée (PRE_CONFIRMEE + 30 min)
  expiresAt         DateTime?         @map("expires_at")
  paidAt            DateTime?         @map("paid_at")
  deliveredAt       DateTime?         @map("delivered_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id])
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  livreur      Livreur?      @relation(fields: [livreurId], references: [id])
  items        OrderItem[]
  payments     Payment[]

  @@index([status])
  @@index([statutPaiement])
  @@index([canalFinalisation])
  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([expiresAt]) // pour le cron d'expiration (workflow 3)
  @@map("orders")
}

// ─── Lignes de commande ──────────────────────────────────────────────────────

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  chaussureId   String  @map("chaussure_id")
  quantity      Int
  // Snapshot au moment de la commande
  pointure      String?
  couleur       String?
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(10, 2)
  chaussureNom  String  @map("chaussure_nom")
  chaussureRef  String  @map("chaussure_ref")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  chaussure Chaussure @relation(fields: [chaussureId], references: [id])

  @@index([orderId])
  @@index([chaussureId])
  @@map("order_items")
}

// ─── Paiements ────────────────────────────────────────────────────────────────

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  provider          PaymentProvider
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("XOF")
  transactionRef    String?         @unique @map("transaction_ref")
  providerPaymentId String?         @map("provider_payment_id")
  paymentLink       String?         @map("payment_link")
  failureReason     String?         @map("failure_reason")
  // Clé d'idempotence — empêche double traitement des webhooks
  idempotencyKey    String          @unique @map("idempotency_key")
  webhookPayload    Json?           @map("webhook_payload")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([transactionRef])
  @@map("payments")
}

// ─── Points de fidélité ──────────────────────────────────────────────────────

model LoyaltyPoint {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  points     Int
  reason     String
  orderId    String?  @map("order_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("loyalty_points")
}

// ─── Logs d'import CSV ────────────────────────────────────────────────────────

model ImportLog {
  id                 String   @id @default(uuid())
  date               DateTime @default(now())
  fichier            String
  nbArticlesImportes Int      @default(0) @map("nb_articles_importes")
  nbErreurs          Int      @default(0) @map("nb_erreurs")
  // SUCCESS | PARTIAL | ERROR
  statut             String
  detailsErreurs     Json?    @map("details_erreurs")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("import_logs")
}
